---
const record = [
  { figure: '₦365bn', label: "Access Bank's rights issue, digitised with Ubon leading the analysis" },
  { figure: '89%', label: 'Less time on general ledger reconciliation, from 8 hours to 45 minutes, using RPA' },
  { figure: '13+', label: 'African subsidiaries reached by cross-border automation he delivered at Access Bank' },
  { figure: '14', label: 'Modules in a government accounting system, with Ubon as the sole business analyst' },
];
---
<section class="trainer ground-paper section" id="trainer" aria-labelledby="trainer-title">
  <div class="container trainer-grid">
    <!-- TODO(ubon): replace this tile's contents with a real photo:
         <img src="/images/ubon-udonkang.webp" alt="Ubon Udonkang teaching a live session" /> -->
    <figure class="portrait leaf-lg">
      <img class="portrait-mark" src="/brand/practeva-symbol-reversed.svg" alt="" width="96" height="97" />
      <figcaption>
        <b>Ubon Udonkang</b>
        <span>Founder and lead trainer</span>
      </figcaption>
    </figure>

    <div class="trainer-copy">
      <h2 id="trainer-title" class="display">Taught by a working business analyst.</h2>
      <p class="lead">Ubon is a business analyst in the Architecture and Engineering team at MTN Nigeria, and previously worked at Access Bank. He holds the PSM I certification, is working towards CBAP, and his work spans fintech, banking operations, process automation and Open Banking regulation.</p>

      <dl class="record">
        {record.map((r) => (
          <div>
            <dt>{r.figure}</dt>
            <dd>{r.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .trainer-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-14) clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--deep-green);
  }

  .portrait img:not(.portrait-mark) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-mark {
    width: 96px;
    height: auto;
  }

  .portrait figcaption {
    position: absolute;
    left: var(--space-6);
    bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    color: #ffffff;
  }

  .portrait figcaption b {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
  }

  .portrait figcaption span {
    font-size: 14px;
    line-height: 20px;
    color: var(--on-deep-muted);
  }

  .trainer-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .record {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    margin-top: var(--space-8);
  }

  .record div {
    padding-top: var(--space-4);
    border-top: 1.5px solid var(--deep-green);
  }

  .record dt {
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--heading);
  }

  .record dd {
    max-width: 22em;
    margin-top: var(--space-3);
    font-size: 15px;
    line-height: 22px;
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .trainer-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 420px;
    }
  }

  @media (max-width: 560px) {
    .record {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
