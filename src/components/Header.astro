---
import Arrow from './Arrow.astro';
import { nav } from '../data/site';

interface Props {
  tone?: 'night' | 'paper';
  cta?: { label: string; href: string };
}

const { tone = 'night', cta = { label: 'Book a call', href: '/contact' } } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// Reversed logo on night, colour logo on light grounds, per the brand guide
const logo = tone === 'night' ? 'reversed' : 'color';
---
<header class:list={['site-header', tone === 'night' ? 'ground-night' : 'ground-paper']}>
  <div class="container bar">
    <a href="/" class="brand">
      <!-- Horizontal lockup at its 64px minimum; below that width the symbol stands alone, per the brand guide -->
      <img class="brand-lockup" src={`/brand/practeva-lockup-horizontal-${logo}.svg`} alt="Practeva home" width="254" height="64" />
      <img class="brand-symbol" src={`/brand/practeva-symbol-${logo}.svg`} alt="Practeva home" width="40" height="40" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn header-cta" href={cta.href}>{cta.label}<Arrow /></a>

    <button class="menu-toggle press" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-icon" aria-hidden="true"></span>
      <span>Menu</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Main, mobile">
      <ul>
        {nav.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a></li>
      </ul>
      <a class="btn" href={cta.href}>{cta.label}<Arrow /></a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    background: transparent;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-block: 28px;
  }

  .brand {
    flex-shrink: 0;
    border-radius: 8px;
  }

  .brand-lockup {
    width: 254px;
    height: 64px;
  }

  .brand-symbol {
    display: none;
    width: 40px;
    height: 40px;
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    gap: var(--space-8);
  }

  .nav a {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding-block: var(--space-2);
    background: linear-gradient(var(--accent-text), var(--accent-text)) left bottom / 0 1.5px no-repeat;
    transition: background-size var(--duration-ui) var(--ease-out);
  }

  .nav a[aria-current='page'] {
    background-size: 100% 1.5px;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      background-size: 100% 1.5px;
    }
  }

  .header-cta {
    min-height: 46px;
    padding: 0 20px;
    font-size: 15px;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-left: auto;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font: 600 15px/1 var(--font-sans);
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--duration-ui) var(--ease-out);
  }

  .menu-icon {
    position: relative;
    transform: translateY(-3px);
  }

  .menu-icon::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon {
    transform: translateY(0) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  /* The panel drops from the bar that opened it and leaves the same way, a little faster.
     Browsers without @starting-style or discrete display transitions show and hide it instantly. */
  .mobile-menu {
    background: var(--surface);
    border-block: 1px solid var(--line);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity var(--duration-ui) var(--ease-out),
      transform var(--duration-ui) var(--ease-out),
      display var(--duration-ui) allow-discrete;
  }

  .mobile-menu[hidden] {
    display: none;
    opacity: 0;
    transform: translateY(calc(-8px * var(--motion)));
    transition-duration: 150ms;
  }

  @starting-style {
    .mobile-menu {
      opacity: 0;
      transform: translateY(calc(-8px * var(--motion)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon,
    .menu-icon::before {
      transition: none;
    }
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-8);
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu li + li {
    border-top: 1px solid var(--line);
  }

  .mobile-menu ul a {
    display: block;
    padding-block: var(--space-4);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mobile-menu ul a[aria-current='page'] {
    color: var(--accent-text);
  }

  .mobile-menu .btn {
    align-self: flex-start;
  }

  @media (max-width: 1080px) {
    .nav ul {
      gap: var(--space-6);
    }

    .header-cta {
      display: none;
    }
  }

  @media (max-width: 880px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 560px) {
    .bar {
      padding-block: 20px;
    }

    .brand-lockup {
      display: none;
    }

    .brand-symbol {
      display: block;
    }
  }
</style>
