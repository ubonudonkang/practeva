---
// The twelve weeks as five phases, each with what is taught, the tools used and the one thing you
// hand in. The last phase closes the cohort, so it is filled deep-green, as ProcessFlow fills its
// final step. Content is in offers.ts (cohortPhases).
import JoinCta from './JoinCta.astro';
import SectionHead from './SectionHead.astro';
import { cohortPhases } from '../data/offers';
---
<section class="weeks ground-paper section" id="weeks" aria-labelledby="weeks-title">
  <div class="container">
    <SectionHead
      id="weeks-title"
      label="The 12 weeks"
      title="Five phases, one project, start to finish."
      note="You follow one case from the kickoff brief to the board presentation, the way an analyst would on the job. Every phase ends in something you hand in."
    />

    <ol class="phases">
      {cohortPhases.map((p, i) => (
        <li class:list={['phase', { final: i === cohortPhases.length - 1 }]}>
          <p class="phase-when label">{p.weeks}</p>
          <div class="phase-main">
            <h3 class="subheading">{p.name}</h3>
            <p class="phase-detail">{p.detail}</p>
          </div>
          <dl class="phase-facts">
            <div>
              <dt class="label">Tools</dt>
              <dd>{p.tools}</dd>
            </div>
            <div>
              <dt class="label">Deliverable</dt>
              <dd class="phase-deliverable">{p.deliverable}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>

    <JoinCta spaced />
  </div>
</section>

<style>
  .phases {
    border-top: 1px solid var(--line);
  }

  .phase {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: var(--space-3) clamp(24px, 4vw, 56px);
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--line);
  }

  .phase-when {
    padding-top: 6px;
  }

  .phase-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .phase-detail {
    max-width: 32em;
    font-size: 16px;
    line-height: 24px;
    color: var(--ink-muted);
  }

  .phase-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .phase-facts dt {
    margin-bottom: var(--space-1);
  }

  .phase-facts dd {
    font-size: 15px;
    line-height: 22px;
    color: var(--ink-muted);
  }

  .phase-facts .phase-deliverable {
    font-weight: var(--weight-title);
    color: var(--heading);
  }

  /* The end of the process: a deep-green box, with the text reading from the box's own tokens */
  .phase.final {
    --heading: #ffffff;
    --ink-muted: var(--on-deep-muted);
    padding-inline: var(--space-6);
    border-bottom-color: transparent;
    background: var(--deep-green);
  }

  @media (max-width: 960px) {
    .phase {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-6);
    }

    .phase-when {
      padding-top: 0;
    }

    .phase.final {
      padding-inline: var(--space-4);
    }
  }
</style>
