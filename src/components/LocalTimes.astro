---
// A time in Lagos (West Africa Time, UTC+1 all year) shown in each city in `cities` (site.ts),
// in standard time and in local summer time. Used for our working day on the international
// page and for the cohort's live sessions on training.
import { cities } from '../data/site';

interface Props {
  /** Start and end in Lagos, as 24-hour clock hours */
  from: number;
  to: number;
  /** Show how the hours meet each city's working day */
  share?: boolean;
}

const { from, to, share = false } = Astro.props;
const LAGOS_UTC = 1;

const clock = (h: number) => {
  const x = ((h % 24) + 24) % 24;
  if (x === 0) return 'midnight';
  if (x === 12) return 'noon';
  return x < 12 ? `${x}am` : `${x - 12}pm`;
};
const range = (offset: number) => `${clock(from - LAGOS_UTC + offset)} to ${clock(to - LAGOS_UTC + offset)}`;
---
<div class="times-wrap">
  <table class="times">
    <thead>
      <tr>
        <th scope="col">Your city</th>
        <th scope="col">Standard time</th>
        <th scope="col">Summer time</th>
        {share && <th scope="col">What we share</th>}
      </tr>
    </thead>
    <tbody>
      {cities.map((c) => (
        <tr>
          <th scope="row">{c.name}</th>
          <td data-label="Standard time">{range(c.utc)}</td>
          <td data-label="Summer time">{c.summer === null ? 'No change' : range(c.summer)}</td>
          {share && <td class="muted" data-label="What we share">{c.share}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .times-wrap {
    overflow-x: auto;
  }

  .times {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 17px;
    line-height: 24px;
  }

  th,
  td {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-top: 1px solid var(--line);
  }

  tbody th {
    font-weight: var(--weight-title);
    color: var(--heading);
  }

  .muted {
    color: var(--ink-muted);
  }

  /* Phones: one block per city, each time labelled, instead of a table to scroll sideways */
  @media (max-width: 640px) {
    .times {
      min-width: 0;
      border-top: 1px solid var(--line);
    }

    thead {
      display: none;
    }

    tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-1) var(--space-4);
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--line);
    }

    tbody th,
    td {
      padding: 0;
      border: 0;
    }

    tbody th {
      grid-column: 1 / -1;
    }

    td::before {
      content: attr(data-label);
      display: block;
      font-size: 12px;
      line-height: 18px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    td.muted {
      grid-column: 1 / -1;
      margin-top: var(--space-2);
    }
  }
</style>
