---
// Offers as a row of leaf-tile cards; the first is filled deep-green as the place to start.
// 'full' shows what each includes and links to the contact form with the offer preselected;
// 'compact' shows the summary and links to the page that sells them.
interface Offer {
  slug: string;
  name: string;
  tag?: string;
  summary: string;
  includes: string[];
  bestFor?: string;
  price: string;
}

interface Props {
  items: Offer[];
  /** Contact form topic the 'full' links preselect */
  topic: string;
  variant?: 'full' | 'compact';
  /** Where 'compact' cards link */
  href?: string;
}

const { items, topic, variant = 'full', href = '/contact' } = Astro.props;
---
<ol class:list={['offers', variant]}>
  {items.map((o, i) => (
    <li class:list={['offer', 'leaf', { featured: i === 0 }]}>
      {o.tag && <p class="offer-tag">{o.tag}</p>}
      <h3 class="offer-name">{o.name}</h3>
      <p class="offer-summary">{o.summary}</p>
      {variant === 'full' && (
        <div class="offer-detail">
          <h4 class="offer-sub">What you get</h4>
          <ul class="offer-includes">
            {o.includes.map((x) => <li>{x}</li>)}
          </ul>
          {o.bestFor && (
            <p class="offer-best"><b>Best for:</b> {o.bestFor}</p>
          )}
        </div>
      )}
      <div class="offer-foot">
        <p class="offer-price">{o.price || 'Quoted after an intro call'}</p>
        {variant === 'full' ? (
          <a class="offer-link" href={`/contact?topic=${topic}&offer=${o.slug}`}>Ask about this<span class="visually-hidden">: {o.name}</span></a>
        ) : (
          <a class="offer-link" href={href}>What's included<span class="visually-hidden">: {o.name}</span></a>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .offers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(24px, 2.6vw, 36px);
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink);
  }

  /* The place to start: deep-green with white text (10.4:1), highlight accents (5.6:1) */
  .featured {
    --heading: #ffffff;
    --ink-muted: var(--on-deep-muted);
    border-color: transparent;
    background: var(--deep-green);
    color: #ffffff;
  }

  .offer-tag {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .featured .offer-tag {
    color: var(--highlight);
  }

  .offer-name {
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 1.1;
    font-weight: var(--weight-headline);
    letter-spacing: -0.03em;
    color: var(--heading);
  }

  .offer-summary {
    font-size: 16px;
    line-height: 24px;
    color: var(--ink-muted);
  }

  .offer-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .featured .offer-detail,
  .featured .offer-foot {
    border-color: rgb(255 255 255 / 0.28);
  }

  .offer-sub {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--heading);
  }

  .offer-includes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .offer-includes li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 22px;
  }

  .offer-includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 5px 0 5px 0;
    background: var(--leaf-green);
  }

  .featured .offer-includes li::before {
    background: var(--highlight);
  }

  .offer-best {
    font-size: 15px;
    line-height: 22px;
    color: var(--ink-muted);
  }

  .offer-best b {
    font-weight: 600;
    color: var(--heading);
  }

  .offer-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .offer-price {
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }

  .offer-link {
    font-size: 15px;
    font-weight: 600;
    color: var(--forest-green);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .featured .offer-link {
    color: var(--highlight);
  }

  .offer-link:hover {
    text-decoration-thickness: 2.5px;
  }

  @media (max-width: 960px) {
    .offers {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
