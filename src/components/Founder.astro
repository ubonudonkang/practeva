---
// Ubon, with his bio and track record, beside a leaf-tile portrait.
import Record from './Record.astro';
import { founder } from '../data/site';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---
<section class="founder ground-paper section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container founder-grid">
    <!-- TODO(ubon): replace this tile's contents with a real photo:
         <img src="/images/ubon-udonkang.webp" alt="Ubon Udonkang teaching a live session" /> -->
    <figure class="portrait leaf-lg">
      <img class="portrait-mark" src="/brand/practeva-symbol-reversed.svg" alt="" width="96" height="97" />
      <figcaption>
        <b>{founder.name}</b>
        <span>{founder.role}</span>
      </figcaption>
    </figure>

    <div class="founder-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={`${id}-title`} class="display">{title}</h2>
      <p class="lead">{founder.bio}</p>
      <div class="founder-record">
        <Record cols={2} />
      </div>
    </div>
  </div>
</section>

<style>
  .founder-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-14) clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--deep-green);
  }

  .portrait img:not(.portrait-mark) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-mark {
    width: 96px;
    height: auto;
  }

  .portrait figcaption {
    position: absolute;
    left: var(--space-6);
    bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    color: #ffffff;
  }

  .portrait figcaption b {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
  }

  .portrait figcaption span {
    font-size: 14px;
    line-height: 20px;
    color: var(--on-deep-muted);
  }

  .founder-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .founder-record {
    margin-top: var(--space-8);
  }

  @media (max-width: 960px) {
    .founder-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 420px;
    }
  }
</style>
