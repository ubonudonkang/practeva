---
// Ubon, with his bio and track record, beside his portrait.
import Record from './Record.astro';
import { founder } from '../data/site';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---
<section class="founder ground-paper section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container founder-grid">
    <!-- The caption sits under the photo: white text would not read on its light background -->
    <figure class="portrait">
      <div class="portrait-frame">
        <img src={founder.photo} alt={founder.photoAlt} width="862" height="1080" loading="lazy" />
      </div>
      <figcaption>
        <b>{founder.name}</b>
        <span>{founder.role}</span>
      </figcaption>
    </figure>

    <div class="founder-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={`${id}-title`} class="display">{title}</h2>
      <p class="lead">{founder.bio}</p>
      <div class="founder-record">
        <Record cols={2} />
      </div>
    </div>
  </div>
</section>

<style>
  .founder-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-14) clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .portrait {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .portrait-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--line);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait figcaption {
    display: flex;
    flex-direction: column;
  }

  .portrait figcaption b {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
    color: var(--heading);
  }

  .portrait figcaption span {
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }

  .founder-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .founder-record {
    margin-top: var(--space-8);
  }

  @media (max-width: 960px) {
    .founder-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 420px;
    }
  }
</style>
