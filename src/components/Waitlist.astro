---
import Arrow from './Arrow.astro';
import { cohort, forms, site } from '../data/site';
---
<section class="waitlist ground-night section" id="waitlist" aria-labelledby="waitlist-title">
  <div class="container waitlist-grid">
    <div class="waitlist-copy">
      <p class="eyebrow">{cohort.next} cohort</p>
      <h2 id="waitlist-title" class="display">The next cohort opens to the waitlist first.</h2>
      <p class="lead">Add your details and we'll contact you when enrolment opens. Each cohort takes {cohort.size}.</p>
    </div>

    <form
      class="form-card waitlist-form"
      data-endpoint={forms.waitlist}
      data-email={site.email}
      data-pending="Joining…"
      data-success="You're on the waitlist. We'll email you when enrolment opens."
      data-offline={`The waitlist form is not connected yet. Email ${site.email} and we'll add you.`}
      novalidate
    >
      <div class="field">
        <label for="wl-name">Full name</label>
        <input id="wl-name" name="name" type="text" autocomplete="name" required data-error="Add your full name so we know who to contact." />
      </div>
      <div class="field">
        <label for="wl-email">Email</label>
        <input id="wl-email" name="email" type="email" autocomplete="email" required data-error="Add an email address we can reach you on, like name@example.com." />
      </div>
      <div class="field">
        <label for="wl-phone">WhatsApp number</label>
        <input id="wl-phone" name="phone" type="tel" autocomplete="tel" placeholder="+234" />
      </div>
      <div class="field">
        <label for="wl-role">What do you do now? <span class="optional">Optional</span></label>
        <input id="wl-role" name="role" type="text" autocomplete="organization-title" />
      </div>
      <button class="btn" type="submit"><span class="btn-label">Join the waitlist</span><Arrow /></button>
      <p class="form-note">We only use these details to contact you about Practeva cohorts.</p>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  import { wireForm } from '../scripts/forms';
  wireForm(document.querySelector<HTMLFormElement>('.waitlist-form'));
</script>

<style>
  .waitlist {
    background-image:
      linear-gradient(rgb(3 22 15 / 0.9), rgb(3 22 15 / 0.9)),
      url('/images/practeva-background-maze.webp');
    background-size: cover;
    background-position: center;
  }

  .waitlist-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-14) clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .waitlist-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (max-width: 960px) {
    .waitlist-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
