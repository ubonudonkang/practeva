---
import Arrow from './Arrow.astro';
import { cohort } from '../data/site';
---
<section class="hero ground-night" aria-labelledby="hero-title">
  <!-- Two translucent planes cut to the shape of the leaves in the P -->
  <div class="hero-planes" aria-hidden="true">
    <span class="plane plane-upper"></span>
    <span class="plane plane-lower"></span>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{cohort.next} cohort</p>
      <!-- The italic accent word is the brand's signature: once per page, and this is the one -->
      <h1 id="hero-title" class="hero-title">Learn business analysis by <em class="accent">doing</em> the&nbsp;work.</h1>
      <p class="hero-sub">Live cohorts, real case work and career support for people moving into IT business analysis.</p>
      <div class="hero-actions">
        <a class="btn" href="#waitlist">Join the waitlist<Arrow /></a>
        <a class="link" href="#how">See how a cohort works</a>
      </div>
    </div>

    <dl class="hero-facts">
      <div>
        <dt>Format</dt>
        <dd>{cohort.format}</dd>
      </div>
      <div>
        <dt>Cohort size</dt>
        <dd>{cohort.size}</dd>
      </div>
      <div>
        <dt>Next cohort</dt>
        <dd>{cohort.next}, waitlist open</dd>
      </div>
      <div>
        <dt>{cohort.previous} cohort</dt>
        <dd>{cohort.previousStatus}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: min(100svh, 960px);
    /* Brand rule: a textured photo always sits under night, never lighter than 55% */
    background-image:
      linear-gradient(100deg, rgb(3 22 15 / 0.94) 0%, rgb(3 22 15 / 0.86) 42%, rgb(3 22 15 / 0.58) 100%),
      url('/images/practeva-background-deep.webp');
    background-size: cover;
    background-position: center 70%;
  }

  .hero {
    overflow: hidden;
  }

  .hero-planes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --plane-w: clamp(360px, 40vw, 640px);
    --plane-top: clamp(150px, 17vw, 230px);
  }

  .plane {
    position: absolute;
    display: block;
    aspect-ratio: 2 / 1;
  }

  /* Upper leaf: pointed top-right and bottom-left, rounded the other two corners */
  .plane-upper {
    top: var(--plane-top);
    right: calc(var(--plane-w) * -0.22);
    width: var(--plane-w);
    border-radius: 50% 0 50% 0 / 100% 0 100% 0;
    background: rgb(255 255 255 / 0.035);
    border: 1px solid rgb(255 255 255 / 0.1);
  }

  /* Lower leaf: the mirror, overlapping the upper one where business meets technology */
  .plane-lower {
    top: calc(var(--plane-top) + var(--plane-w) * 0.38);
    right: calc(var(--plane-w) * 0.1);
    width: calc(var(--plane-w) * 0.9);
    border-radius: 0 50% 0 50% / 0 100% 0 100%;
    background: rgb(132 210 98 / 0.07);
    border: 1px solid rgb(132 210 98 / 0.2);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 168px;
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .hero-title {
    max-width: 9.6em;
    font-size: clamp(46px, 7.6vw, 112px);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: var(--heading);
  }

  .hero-title .accent {
    padding-right: 0.04em;
  }

  .hero-sub {
    max-width: 30em;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-2);
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: clamp(56px, 8vw, 104px);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .hero-facts dt {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero-facts dd {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 24px;
    font-weight: 600;
  }

  /* The page's one orchestrated moment: the hero settles in on load.
     The call to action is settled by about 780ms. */
  .hero-copy > * {
    animation: rise 600ms var(--ease-out) both;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero-copy > :nth-child(4) {
    animation-delay: 180ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(calc(16px * var(--motion)));
    }
  }

  /* Reduced motion: one short fade, all together */
  @media (prefers-reduced-motion: reduce) {
    .hero-copy > :nth-child(n) {
      animation-duration: var(--duration-ui);
      animation-delay: 0ms;
    }
  }

  @media (max-width: 1080px) {
    .hero-planes {
      display: none;
    }
  }

  @media (max-width: 880px) {
    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: auto;
    }

    .hero-inner {
      padding-top: 128px;
    }
  }
</style>
