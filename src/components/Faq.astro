---
import { site } from '../data/site';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  /** True when a paper section comes before it: it shares that section's spacing and sits
      under a hairline. False after a night or wash section, so it keeps its own top spacing. */
  joined?: boolean;
}

const { items, title = 'Questions people ask', joined = true } = Astro.props;
---
<section class:list={['faq', 'ground-paper', 'section', { joined }]} id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-head">
      <h2 id="faq-title" class="display">{title}</h2>
      <p class="caption">Something else? Email <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <div class="faq-list" data-accordion>
      {items.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { smoothAccordion } from '../scripts/accordion';
  document.querySelectorAll<HTMLElement>('.faq-list[data-accordion]').forEach(smoothAccordion);
</script>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8) clamp(32px, 6vw, 96px);
  }

  .joined {
    padding-top: 0;
  }

  .joined .faq-grid {
    padding-top: var(--section-y);
    /* A hairline that lines up with the content, not the container's padding */
    background: linear-gradient(var(--line), var(--line)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }

  .faq-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
    padding-block: var(--space-4);
    font-size: 19px;
    line-height: 26px;
    font-weight: var(--weight-title);
    letter-spacing: -0.01em;
    color: var(--heading);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--deep-green);
    border-radius: 50%;
    transition: transform var(--duration-ui) var(--ease-out);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 11px;
    height: 1.5px;
    background: var(--deep-green);
    transform: translate(-50%, -50%);
  }

  .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  /* Answers open and close smoothly; browsers without ::details-content keep the instant open */
  details::details-content {
    block-size: 0;
    opacity: 0;
    overflow: clip;
    transition:
      block-size var(--duration-panel) var(--ease-out),
      opacity var(--duration-ui) var(--ease-out),
      content-visibility var(--duration-panel) allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  /* With the script running it animates the height itself; switch the CSS-only path off */
  .faq-list[data-smooth] details::details-content {
    block-size: auto;
    opacity: 1;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition:
        opacity var(--duration-ui) var(--ease-out),
        content-visibility var(--duration-ui) allow-discrete;
    }

    .faq-icon {
      transition: none;
    }
  }

  details p {
    max-width: 36em;
    padding-bottom: var(--space-6);
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    summary {
      font-size: 17px;
      line-height: 24px;
    }
  }
</style>
