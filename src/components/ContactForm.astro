---
// The contact form. Links can preselect a topic and name an offer:
// /contact?topic=advisory&offer=quick-read
// It posts to the Apps Script's Contact tab, which keeps first_name, last_name, email, company,
// type, message and submission_id. On submit the topic becomes type ("Practeva: …", so these
// stand apart from ubonudonkang.com's enquiries) and a phone number joins the end of the message.
import Arrow from './Arrow.astro';
import { forms, site, topics } from '../data/site';
import { careerServices, packages } from '../data/offers';

// Offer names by slug, so a link from an offer card can start the message for the visitor
const offerNames = Object.fromEntries([...packages, ...careerServices].map((o) => [o.slug, o.name]));
---
<form
  class="form-card contact-form"
  data-endpoint={forms.contact}
  data-email={site.email}
  data-pending="Sending…"
  data-success="Thanks, your message is with us. We'll reply by email."
  data-offers={JSON.stringify(offerNames)}
  novalidate
>
  <input type="hidden" name="form_name" value="contact" />
  <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="field-row">
    <div class="field">
      <label for="ct-first">First name</label>
      <input id="ct-first" name="first_name" type="text" autocomplete="given-name" required data-error="Add your first name so we know who to reply to." />
    </div>
    <div class="field">
      <label for="ct-last">Last name</label>
      <input id="ct-last" name="last_name" type="text" autocomplete="family-name" required data-error="Add your last name too." />
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="ct-email">Email</label>
      <input id="ct-email" name="email" type="email" autocomplete="email" required data-error="Add an email address we can reply to, like name@example.com." />
    </div>
    <div class="field">
      <label for="ct-phone">Phone or WhatsApp <span class="optional">Optional</span></label>
      <input id="ct-phone" name="phone" type="tel" autocomplete="tel" placeholder="+234" />
    </div>
  </div>
  <div class="field">
    <label for="ct-org">Organisation <span class="optional">Optional</span></label>
    <input id="ct-org" name="company" type="text" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="ct-topic">What can we help with?</label>
    <select id="ct-topic" name="topic" required data-error="Choose what you'd like help with.">
      <option value="">Choose one</option>
      {topics.map((t) => <option value={t.value}>{t.label}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="ct-message">Tell us a little more</label>
    <textarea id="ct-message" name="message" rows="5" required data-error="Add a line or two about what you're working on."></textarea>
  </div>
  <button class="btn" type="submit"><span class="btn-label">Send message</span><Arrow /></button>
  <p class="form-note">We only use these details to reply to you.</p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  import { uniqueId, wireForm, type Params } from '../scripts/forms';

  const form = document.querySelector<HTMLFormElement>('.contact-form');

  // Shape the post for the Contact tab: the topic's label as type, the phone in the message,
  // and a fresh id the script uses to ignore a repeat of the same submission.
  wireForm(form, (params, f) => {
    const topic = f.elements.namedItem('topic') as HTMLSelectElement;
    const { topic: _topic, phone, ...rest }: Params = params;
    const out: Params = {
      ...rest,
      type: `Practeva: ${topic.selectedOptions[0]?.textContent?.trim() ?? 'Enquiry'}`,
      submission_id: uniqueId(),
    };
    if (phone) out.message = `${params.message}\n\nPhone or WhatsApp: ${phone}`;
    return out;
  });

  // Preselect the topic and start the message when a link names them
  if (form) {
    const params = new URLSearchParams(window.location.search);
    const topic = form.elements.namedItem('topic') as HTMLSelectElement;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const wanted = params.get('topic');
    if (wanted && [...topic.options].some((o) => o.value === wanted)) topic.value = wanted;

    const offers = JSON.parse(form.dataset.offers ?? '{}') as Record<string, string>;
    const offer = offers[params.get('offer') ?? ''];
    if (offer && !message.value) message.value = `I'd like to ask about the ${offer}.\n\n`;
  }
</script>

<style>
  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
