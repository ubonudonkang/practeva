---
import SectionHead from './SectionHead.astro';
import { cohort } from '../data/site';

// One band per pillar, in the tagline's order; Advisory opens first because it leads.
const bands = [
  {
    key: 'advisory',
    name: 'Advisory',
    tease: 'For organisations and founders',
    body: 'Business analysis, process improvement and automation, business systems and digital transformation. We start with what the business needs, then help change the process and the technology to match.',
    facts: ['Business analysis', 'Process automation', 'Digital transformation'],
    link: { href: '/advisory', label: 'See advisory' },
  },
  {
    key: 'training',
    name: 'Training',
    tease: 'For new analysts and teams',
    body: 'Twelve weeks of live, case-based training for people moving into IT business analysis, and workshops for teams who want sharper analysis skills.',
    facts: [cohort.programme, `Next cohort: ${cohort.next}`, 'Team training'],
    link: { href: '/training', label: 'See training' },
  },
  {
    key: 'careers',
    name: 'Careers',
    tease: 'For new and aspiring analysts',
    body: 'Your CV and profile rewritten around business analysis work, mock interviews and portfolio reviews, so your skills come through on paper and in the room.',
    facts: ['CV and profile rewrite', 'Mock interview', 'Portfolio review'],
    link: { href: '/careers', label: 'See careers support' },
  },
];
---
<section class="pillars ground-night section" id="what-we-do" aria-labelledby="pillars-title">
  <div class="container">
    <SectionHead
      id="pillars-title"
      label="Advisory, training, careers"
      title="What we do"
      note="Start where you are: building a product, changing a process, learning the craft or applying for roles."
    />

    <!-- The shared name makes the bands an exclusive accordion -->
    <div class="bands" data-accordion>
      {bands.map((b, i) => (
        <details class={`band band-${b.key}`} name="pillars" open={i === 0}>
          <summary>
            <span class="band-name">{b.name}</span>
            <span class="band-tease">{b.tease}</span>
            <span class="band-icon" aria-hidden="true"></span>
          </summary>
          <div class="band-body">
            <p>{b.body}</p>
            <ul class="tags band-facts">
              {b.facts.map((f) => <li>{f}</li>)}
            </ul>
            <a class="band-link" href={b.link.href}>{b.link.label}</a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { smoothAccordion } from '../scripts/accordion';
  document.querySelectorAll<HTMLElement>('.bands[data-accordion]').forEach(smoothAccordion);
</script>

<style>
  .bands {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Pillar colours. Text pairs checked for contrast:
     white on deep-green 10.4:1, night on leaf-green 5.5:1, white on forest-green 5.4:1 */
  .band-advisory {
    --band-bg: var(--deep-green);
    --band-fg: #ffffff;
  }

  .band-training {
    --band-bg: var(--leaf-green);
    --band-fg: var(--night);
  }

  .band-careers {
    --band-bg: var(--forest-green);
    --band-fg: #ffffff;
  }

  .band {
    background: var(--band-bg);
    color: var(--band-fg);
    overflow: hidden;
  }

  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) 44px;
    align-items: center;
    gap: var(--space-6);
    min-height: 84px;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-8);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--band-fg);
    outline-offset: -6px;
  }

  .band-name {
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.1;
    font-weight: var(--weight-headline);
    letter-spacing: -0.03em;
  }

  .band-tease {
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
  }

  .band-icon {
    position: relative;
    width: 44px;
    height: 44px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    justify-self: end;
    transition: transform var(--duration-ui) var(--ease-out);
  }

  .band-icon::before,
  .band-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .band-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .band[open] .band-icon {
    transform: rotate(45deg);
  }

  /* Open and close smoothly, so the bands below slide instead of jumping.
     Opening one band closes the other at the same time, so both heights ease together.
     Browsers without ::details-content keep the instant open. */
  .band::details-content {
    block-size: 0;
    opacity: 0;
    overflow: clip;
    transition:
      block-size var(--duration-panel) var(--ease-out),
      opacity var(--duration-ui) var(--ease-out),
      content-visibility var(--duration-panel) allow-discrete;
  }

  .band[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  /* With the script running it animates the height itself; switch the CSS-only path off so
     the two don't fight */
  .bands[data-smooth] .band::details-content {
    block-size: auto;
    opacity: 1;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .band::details-content {
      transition:
        opacity var(--duration-ui) var(--ease-out),
        content-visibility var(--duration-ui) allow-discrete;
    }

    .band-icon {
      transition: none;
    }
  }

  .band-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-4) var(--space-6);
    padding: var(--space-2) var(--space-8) var(--space-8);
  }

  .band-body p {
    grid-column: 2;
    max-width: 34em;
    font-size: 18px;
    line-height: 27px;
  }

  .band-facts {
    grid-column: 2;
  }

  .band-link {
    grid-column: 2;
    justify-self: start;
    margin-top: var(--space-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .band-link:focus-visible {
    outline-color: var(--band-fg);
  }

  @media (max-width: 760px) {
    summary {
      grid-template-columns: minmax(0, 1fr) 44px;
      row-gap: 2px;
      padding: var(--space-4) var(--space-4) var(--space-4) var(--space-6);
    }

    .band-name {
      grid-row: 1;
    }

    .band-tease {
      grid-row: 2;
      grid-column: 1;
    }

    .band-icon {
      grid-row: 1 / span 2;
      grid-column: 2;
    }

    .band-body {
      grid-template-columns: minmax(0, 1fr);
      padding: 0 var(--space-6) var(--space-6);
    }

    .band-body p,
    .band-facts,
    .band-link {
      grid-column: 1;
    }

    .band-body p {
      font-size: 17px;
      line-height: 26px;
    }
  }
</style>
