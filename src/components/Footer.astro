---
import { site } from '../data/site';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Training',
    links: [
      { href: '#how', label: 'How a cohort works' },
      { href: '#market-day', label: 'Project Market Day' },
      { href: '#faq', label: 'Questions' },
    ],
  },
  {
    title: 'Practeva',
    links: [
      { href: '#what-we-do', label: 'What we do' },
      { href: '#trainer', label: 'Your trainer' },
      { href: '#waitlist', label: 'Join the waitlist' },
    ],
  },
  {
    title: 'Contact',
    links: [
      { href: `mailto:${site.email}`, label: site.email },
      { href: site.url, label: 'practevahq.com' },
    ],
  },
];
---
<footer class="site-footer ground-night">
  <div class="container">
    <div class="footer-top">
      <p class="tagline">{site.tagline}</p>
      <nav class="footer-cols" aria-label="Footer">
        {columns.map((c) => (
          <div>
            <h2 class="col-title">{c.title}</h2>
            <ul>
              {c.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <img class="footer-lockup" src="/brand/practeva-lockup-horizontal-reversed.svg" alt="Practeva" width="1050" height="265" loading="lazy" />

    <p class="legal">© {year} {site.legal}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--line);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8) clamp(32px, 6vw, 96px);
  }

  .tagline {
    max-width: 16em;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .col-title {
    margin-bottom: var(--space-3);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .footer-cols li + li {
    margin-top: var(--space-2);
  }

  .footer-cols a {
    font-size: 15px;
    line-height: 22px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-cols a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Big lockup, the way the reference sites sign off. Clear space above equals the cap height. */
  .footer-lockup {
    width: 100%;
    max-width: 880px;
    height: auto;
    margin-block: clamp(72px, 10vw, 128px) clamp(40px, 6vw, 72px);
  }

  .legal {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: 13px;
    line-height: 20px;
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-cols > div:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
