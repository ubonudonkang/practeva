---
// The cohort's place on the home page: a slim textured band with dates and one pill.
import Arrow from './Arrow.astro';
import { cohort, enrolment, join } from '../data/site';
---
<section class="cohort-banner ground-night section" aria-labelledby="cohort-title">
  <div class="container cb-grid">
    <div class="cb-copy">
      <p class="eyebrow">{cohort.programme}</p>
      <h2 id="cohort-title" class="display">Twelve weeks of live, case-based training for new analysts.</h2>
    </div>
    <div class="cb-aside">
      <ul class="tags">
        <li>{cohort.format}</li>
        <li>{cohort.size}</li>
        <li>{cohort.previous}: {cohort.previousStatus.toLowerCase()}</li>
      </ul>
      <p class="cb-note">{enrolment.open ? `Enrolment for the ${cohort.next} cohort is open.` : `The ${cohort.next} cohort opens to the waitlist first.`}</p>
      <div class="cb-actions">
        <a class="btn" href={join.href}>{join.label}<Arrow /></a>
        <a class="link" href="/training">See how a cohort works</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Brand rule: the maze texture marks the waitlist and dates, always under night */
  .cohort-banner {
    background-image:
      linear-gradient(rgb(3 22 15 / 0.88), rgb(3 22 15 / 0.88)),
      url('/images/practeva-background-maze.webp');
    background-size: cover;
    background-position: center;
  }

  .cb-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8) clamp(32px, 6vw, 96px);
    align-items: end;
  }

  .cb-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .cb-copy h2 {
    max-width: 13em;
  }

  .cb-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .cb-note {
    font-size: 17px;
    line-height: 26px;
    color: var(--ink-muted);
  }

  .cb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }

  @media (max-width: 960px) {
    .cb-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
