---
// A process drawn the way business analysts draw it: start event, tasks joined by arrows,
// end event, and the final task filled deep-green. Three to five steps; names of two to
// four words, details under eight. Sits on paper or wash grounds.
interface Props {
  steps: { name: string; detail: string }[];
  label: string;
}

const { steps, label } = Astro.props;
---
<div class="flow" role="group" aria-label={label}>
  <span class="event event-start" aria-hidden="true"></span>
  <ol class="steps">
    {steps.map((s, i) => (
      <li class:list={['step-item', { final: i === steps.length - 1 }]}>
        <span class="arrow" aria-hidden="true"></span>
        <div class="step">
          <b>{s.name}</b>
          <span>{s.detail}</span>
        </div>
      </li>
    ))}
  </ol>
  <span class="arrow" aria-hidden="true"></span>
  <span class="event event-end" aria-hidden="true"></span>
</div>

<style>
  .flow {
    display: flex;
    align-items: center;
  }

  .steps {
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .step-item {
    display: flex;
    align-items: stretch;
    flex: 1;
    min-width: 0;
  }

  .step-item .arrow {
    align-self: center;
  }

  .event {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border: 2px solid var(--deep-green);
    border-radius: 50%;
    background: var(--surface-raised);
  }

  .event-end {
    border-width: 7px;
  }

  .arrow {
    position: relative;
    flex-shrink: 0;
    width: 28px;
    height: 2px;
    background: var(--deep-green);
  }

  .arrow::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -5px;
    border-left: 9px solid var(--deep-green);
    border-block: 6px solid transparent;
  }

  .step {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    min-height: 116px;
    margin-left: 4px;
    margin-right: 2px;
    padding: 18px 18px 20px;
    border: 2px solid var(--deep-green);
    border-radius: var(--radius-step);
    background: var(--surface-raised);
  }

  .step b {
    font-size: 17px;
    line-height: 21px;
    font-weight: var(--weight-title);
    letter-spacing: -0.02em;
    color: var(--deep-green);
  }

  .step span {
    font-size: 14px;
    line-height: 19px;
    color: var(--ink-muted);
  }

  .final .step {
    background: var(--deep-green);
  }

  .final .step b {
    color: #ffffff;
  }

  .final .step span {
    color: var(--on-deep-muted);
  }

  /* Stacked: one column as wide as the steps, with the events and arrows on its centre line */
  @media (max-width: 1080px) {
    .flow,
    .steps,
    .step-item {
      flex-direction: column;
      align-items: center;
    }

    .flow {
      max-width: 520px;
    }

    .steps,
    .step-item {
      width: 100%;
    }

    .arrow,
    .step-item .arrow {
      align-self: center;
      width: 2px;
      height: 26px;
    }

    .arrow::after {
      top: auto;
      right: auto;
      bottom: -2px;
      left: -5px;
      border-left: 6px solid transparent;
      border-right: 6px solid transparent;
      border-top: 9px solid var(--deep-green);
      border-bottom: 0;
    }

    .step {
      width: 100%;
      min-height: 0;
      margin: 4px 0 2px;
    }
  }
</style>
