---
// A process drawn the way business analysts draw it: start event, tasks, end event.
const steps = [
  { name: 'Learn the craft', detail: 'Live classes, twice a week' },
  { name: 'Work the case', detail: 'Weekly deliverables for Lantern MFB' },
  { name: 'Get reviewed', detail: 'Feedback on every deliverable' },
  { name: 'Prepare for interviews', detail: 'A CV rewrite and a mock interview' },
  { name: 'Present your work', detail: 'Final presentations close the cohort' },
];

const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---
<section class="how ground-paper section" id="how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <h2 id="how-title" class="display">How a cohort works</h2>
      <p class="note">Twelve weeks, live online, built around one case from the first brief to the final presentation.</p>
    </div>

    <div class="flow">
      <span class="event event-start" aria-hidden="true"></span>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class:list={['step-item', { final: i === steps.length - 1 }]}>
            <span class="arrow" aria-hidden="true"></span>
            <div class="step">
              <b>{s.name}</b>
              <span>{s.detail}</span>
            </div>
          </li>
        ))}
      </ol>
      <span class="arrow" aria-hidden="true"></span>
      <span class="event event-end" aria-hidden="true"></span>
    </div>

    <div class="week-panel">
      <div class="week-intro">
        <h3 class="subheading">A typical week</h3>
        <p class="caption">Both live sessions are for the whole cohort and taught by your trainer. Saturday's session reviews the week's deliverable. Your pod meets at a time you agree together.</p>
      </div>

      <!-- Wide screens: a swimlane, one lane per role -->
      <div class="week" aria-hidden="true">
        <span class="lane-head"></span>
        {days.map((d) => <span class="day">{d}</span>)}

        <span class="lane-label" style="grid-row: 2">Live sessions</span>
        <div class="slot slot-live" style="grid-row: 2; grid-column: 4 / 5"><b>Class</b><span>8 to 10pm WAT</span></div>
        <div class="slot slot-live" style="grid-row: 2; grid-column: 7 / 8"><b>Review</b><span>8 to 10pm WAT</span></div>

        <span class="lane-label" style="grid-row: 3">Your pod</span>
        <div class="slot" style="grid-row: 3; grid-column: 5 / 7"><b>Pod session</b><span>At a time your pod agrees</span></div>

        <span class="lane-label" style="grid-row: 4">You</span>
        <div class="slot" style="grid-row: 4; grid-column: 4 / 7"><b>Build the week's deliverable</b><span>Ready for Saturday's review</span></div>
      </div>

      <!-- The same week as a list: what screen readers read, and what phones show -->
      <ol class="week-list">
        <li class="slot slot-live"><b>Wednesday: live class</b><span>8 to 10pm WAT, whole cohort</span></li>
        <li class="slot"><b>Wednesday to Friday: your deliverable</b><span>Build the week's piece of the case</span></li>
        <li class="slot"><b>Thursday or Friday: pod session</b><span>At a time your pod agrees</span></li>
        <li class="slot slot-live"><b>Saturday: live review</b><span>8 to 10pm WAT, the week's deliverable reviewed</span></li>
      </ol>
    </div>
  </div>
</section>

<style>
  /* Flow diagram */
  .flow {
    display: flex;
    align-items: center;
  }

  .steps {
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .step-item {
    display: flex;
    align-items: stretch;
    flex: 1;
    min-width: 0;
  }

  .step-item .arrow {
    align-self: center;
  }

  .event {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border: 2px solid var(--deep-green);
    border-radius: 50%;
    background: var(--surface-raised);
  }

  .event-end {
    border-width: 7px;
  }

  .arrow {
    position: relative;
    flex-shrink: 0;
    width: 28px;
    height: 2px;
    background: var(--deep-green);
  }

  .arrow::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -5px;
    border-left: 9px solid var(--deep-green);
    border-block: 6px solid transparent;
  }

  .step {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    min-height: 116px;
    margin-left: 4px;
    margin-right: 2px;
    padding: 18px 18px 20px;
    border: 2px solid var(--deep-green);
    border-radius: var(--radius-step);
    background: var(--surface-raised);
  }

  .step b {
    font-size: 17px;
    line-height: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--deep-green);
  }

  .step span {
    font-size: 14px;
    line-height: 19px;
    color: var(--ink-muted);
  }

  .final .step {
    background: var(--deep-green);
  }

  .final .step b {
    color: #ffffff;
  }

  .final .step span {
    color: var(--on-deep-muted);
  }

  /* Week swimlane */
  .week-panel {
    margin-top: clamp(48px, 7vw, 88px);
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
  }

  .week-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-14);
    margin-bottom: var(--space-8);
  }

  .week-intro .caption {
    max-width: 40em;
  }

  .week {
    display: grid;
    grid-template-columns: 128px repeat(7, minmax(0, 1fr));
    grid-template-rows: auto repeat(3, minmax(76px, auto));
    column-gap: 8px;
    min-width: 760px;
  }

  .lane-head,
  .day {
    grid-row: 1;
    margin-bottom: 6px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .day {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .lane-label {
    grid-column: 1;
    align-self: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--heading);
  }

  .lane-label,
  .slot {
    margin-block: 6px;
  }

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 10px 14px;
    border: 2px solid var(--deep-green);
    border-radius: 14px;
    background: var(--surface-raised);
  }

  .slot b {
    font-size: 15px;
    line-height: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--deep-green);
  }

  .slot span {
    font-size: 13px;
    line-height: 17px;
    color: var(--ink-muted);
  }

  .slot-live {
    background: var(--deep-green);
  }

  .slot-live b {
    color: #ffffff;
  }

  .slot-live span {
    color: var(--on-deep-muted);
  }

  /* On wide screens the list is for screen readers only */
  .week-list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 1080px) {
    .flow,
    .steps,
    .step-item {
      flex-direction: column;
      align-items: flex-start;
    }

    .flow {
      padding-left: 0;
    }

    .steps,
    .step-item {
      width: 100%;
    }

    .event {
      margin-left: 6px;
    }

    .arrow,
    .step-item .arrow {
      align-self: flex-start;
      width: 2px;
      height: 26px;
      margin-left: 19px;
    }

    .arrow::after {
      top: auto;
      right: auto;
      bottom: -2px;
      left: -5px;
      border-left: 6px solid transparent;
      border-right: 6px solid transparent;
      border-top: 9px solid var(--deep-green);
      border-bottom: 0;
    }

    .step {
      width: 100%;
      max-width: 520px;
      min-height: 0;
      margin: 4px 0 2px;
    }
  }

  @media (max-width: 760px) {
    .week {
      display: none;
    }

    .week-list {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .week-list .slot {
      margin: 0;
      padding: 14px 16px;
    }
  }
</style>
