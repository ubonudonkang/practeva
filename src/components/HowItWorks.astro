---
import JoinCta from './JoinCta.astro';
import ProcessFlow from './ProcessFlow.astro';
import SectionHead from './SectionHead.astro';

const steps = [
  { name: 'Learn the craft', detail: 'Two live classes a week, recorded' },
  { name: 'Work the case', detail: 'Weekly deliverables for Lantern MFB' },
  { name: 'Get reviewed', detail: 'Feedback on every deliverable' },
  { name: 'Prepare for interviews', detail: 'A CV rewrite and a mock interview' },
  { name: 'Present your work', detail: 'Final presentations close the cohort' },
];

const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

interface Props {
  /** True when a paper section comes before it, so the two share one gap and the heading's hairline. */
  joined?: boolean;
}

const { joined = false } = Astro.props;
---
<section class:list={['how', 'ground-paper', 'section', { joined }]} id="how" aria-labelledby="how-title">
  <div class="container">
    <SectionHead
      id="how-title"
      label="How it works"
      title="How a cohort works"
      note="Twelve weeks, live online, built around one case from the first brief to the final presentation."
    >
      <a slot="aside" class="link" href="/training/how-to-become-a-business-analyst-in-nigeria">New to the role? Read our guide</a>
    </SectionHead>

    <ProcessFlow steps={steps} label="The cohort, step by step" />

    <div class="week-panel">
      <div class="week-intro">
        <h3 class="subheading">A typical week</h3>
        <p class="caption">Both live sessions are for the whole cohort, taught by a practising business analyst and recorded. Saturday's session reviews the week's deliverable, and every submission gets written feedback. Your pod, a small review group inside the cohort, meets at a time you agree together, so you see how others approach the same problem.</p>
      </div>

      <!-- Wide screens: a swimlane, one lane per role -->
      <div class="week" aria-hidden="true">
        <span class="lane-head"></span>
        {days.map((d) => <span class="day">{d}</span>)}

        <span class="lane-label" style="grid-row: 2">Live sessions</span>
        <div class="slot slot-live" style="grid-row: 2; grid-column: 4 / 5"><b>Class</b><span>8 to 10pm WAT</span></div>
        <div class="slot slot-live" style="grid-row: 2; grid-column: 7 / 8"><b>Review</b><span>8 to 10pm WAT</span></div>

        <span class="lane-label" style="grid-row: 3">Your pod</span>
        <div class="slot" style="grid-row: 3; grid-column: 5 / 7"><b>Pod session</b><span>At a time your pod agrees</span></div>

        <span class="lane-label" style="grid-row: 4">You</span>
        <div class="slot" style="grid-row: 4; grid-column: 4 / 7"><b>Build the week's deliverable</b><span>Ready for Saturday's review</span></div>
      </div>

      <!-- The same week as a list: what screen readers read, and what phones show -->
      <ol class="week-list">
        <li class="slot slot-live"><b>Wednesday: live class</b><span>8 to 10pm WAT, whole cohort</span></li>
        <li class="slot"><b>Wednesday to Friday: your deliverable</b><span>Build the week's piece of the case</span></li>
        <li class="slot"><b>Thursday or Friday: pod session</b><span>At a time your pod agrees</span></li>
        <li class="slot slot-live"><b>Saturday: live review</b><span>8 to 10pm WAT, the week's deliverable reviewed</span></li>
      </ol>
    </div>

    <JoinCta spaced />
  </div>
</section>

<style>
  /* Paper sections that follow one another share a hairline instead of a gap */
  .joined {
    padding-top: 0;
  }

  /* Week swimlane */
  .week-panel {
    margin-top: clamp(48px, 7vw, 88px);
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
  }

  .week-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-14);
    margin-bottom: var(--space-8);
  }

  .week-intro .caption {
    max-width: 40em;
  }

  .week {
    display: grid;
    grid-template-columns: 128px repeat(7, minmax(0, 1fr));
    grid-template-rows: auto repeat(3, minmax(76px, auto));
    column-gap: 8px;
    min-width: 760px;
  }

  .lane-head,
  .day {
    grid-row: 1;
    margin-bottom: 6px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .day {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .lane-label {
    grid-column: 1;
    align-self: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--heading);
  }

  .lane-label,
  .slot {
    margin-block: 6px;
  }

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 10px 14px;
    border: 2px solid var(--deep-green);
    border-radius: 14px;
    background: var(--surface-raised);
  }

  .slot b {
    font-size: 15px;
    line-height: 19px;
    font-weight: var(--weight-title);
    letter-spacing: -0.01em;
    color: var(--deep-green);
  }

  .slot span {
    font-size: 13px;
    line-height: 17px;
    color: var(--ink-muted);
  }

  .slot-live {
    background: var(--deep-green);
  }

  .slot-live b {
    color: #ffffff;
  }

  .slot-live span {
    color: var(--on-deep-muted);
  }

  /* On wide screens the list is for screen readers only */
  .week-list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* The swimlane needs about 760px of its own; below that, the list reads better */
  @media (max-width: 960px) {
    .week {
      display: none;
    }

    .week-list {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .week-list .slot {
      margin: 0;
      padding: 14px 16px;
    }
  }
</style>
