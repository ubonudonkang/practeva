---
// First, so the page's stylesheets keep the order they had before its words moved into src/content.
import copyContent from '../content/pages/advisory.json';
import { pageCopy } from '../data/pages';

import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import HeroFacts from '../components/HeroFacts.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedGrid from '../components/NumberedGrid.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import OfferCards from '../components/OfferCards.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import ContactBand from '../components/ContactBand.astro';
import { audiences, beforeAfter, engagement, packages, services } from '../data/offers';
import { company } from '../data/site';
import { services as serviceNodes } from '../data/schema';

// The page's words are in src/content/pages/advisory.json (edited in Pages CMS)
const copy = pageCopy('advisory', copyContent, ['who', 'difference', 'packages', 'services', 'process']);
---
<Page
  tone="paper"
  title={copy.seoTitle}
  description={copy.description}
  schema={[
    ...serviceNodes('/advisory/', services, 'Business analysis and technology advisory'),
    ...serviceNodes('/advisory/', packages, 'Advisory package'),
  ]}
>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Advisory' }]}
    sub={copy.hero.sub}
  >
    <Fragment slot="title">{copy.hero.title.before}<em class="accent">{copy.hero.title.accent}</em>{copy.hero.title.after}</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="/contact?topic=advisory">Book a call<Arrow /></a>
      <a class="link" href="#packages">See the packages</a>
    </Fragment>
    <HeroFacts
      items={[
        { term: 'Who it is for', detail: 'Founders, product teams and operations leads' },
        { term: 'Where to start', detail: 'A quick read of what you have' },
        { term: 'Based in', detail: company.location },
      ]}
    />
  </PageHero>

  <section class="ground-paper section" aria-labelledby="who-title">
    <div class="container">
      <SectionHead id="who-title" {...copy.section('who')} />
      <NumberedGrid items={audiences} cols={4} />
    </div>
  </section>

  <section class="ground-paper section difference" aria-labelledby="difference-title">
    <div class="container">
      <SectionHead id="difference-title" {...copy.section('difference')} />
      <BeforeAfter before={beforeAfter.before} after={beforeAfter.after} />
    </div>
  </section>

  <section class="ground-wash section packages" id="packages" aria-labelledby="packages-title">
    <div class="container">
      <SectionHead id="packages-title" {...copy.section('packages')} />
      <OfferCards items={packages} topic="advisory" />
    </div>
  </section>

  <section class="ground-paper section" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHead id="services-title" {...copy.section('services')} />
      <NumberedGrid items={services} cols={3} />
    </div>
  </section>

  <section class="ground-paper section process" id="process" aria-labelledby="process-title">
    <div class="container">
      <SectionHead id="process-title" {...copy.section('process')}>
        <a slot="aside" class="link" href="/advisory/international">Working with us from abroad</a>
      </SectionHead>
      <ProcessFlow steps={engagement} label="An advisory engagement, step by step" />
    </div>
  </section>

  <ContactBand
    title={copy.band.title}
    note={copy.band.note}
    cta={{ label: copy.band.label, href: '/contact?topic=advisory' }}
  />
</Page>

<style>
  /* Paper sections that follow one another share a hairline instead of a gap */
  .difference,
  .process {
    padding-top: 0;
  }

  .packages {
    --wash-x: 100%;
    --wash-y: 40%;
    --wash2-x: 0%;
    --wash2-y: 70%;
  }
</style>
