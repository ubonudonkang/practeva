---
// A guide for people in Nigeria who want to become business analysts: what the role is, where
// it is done, what to learn and in what order. Written to answer the question directly, for
// readers, search engines and AI assistants alike. No figures we can't stand behind: no
// salaries, no job promises, no timelines beyond the cohort's own length.
import Page from '../../layouts/Page.astro';
import Arrow from '../../components/Arrow.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import NumberedGrid from '../../components/NumberedGrid.astro';
import ProcessFlow from '../../components/ProcessFlow.astro';
import Faq from '../../components/Faq.astro';
import CohortBanner from '../../components/CohortBanner.astro';
import { cohort, site } from '../../data/site';
import { orgId, pageUrl } from '../../data/schema';

const path = '/training/how-to-become-a-business-analyst-in-nigeria/';
const title = 'How to become a business analyst in Nigeria | Practeva';
const description =
  'What business analysts do, the skills and tools to learn, whether you need a certification, and how career changers in Nigeria can build work employers can see.';

const duties = [
  'Interviewing stakeholders and running workshops to understand the problem.',
  'Mapping how work happens today and how it should happen, usually in BPMN.',
  'Writing business requirements, user stories and acceptance criteria.',
  'Checking that what is delivered matches what was agreed, through user acceptance testing (UAT).',
];

const skills = [
  { name: 'Elicitation', detail: 'Asking good questions in interviews and workshops, and noticing what people leave out.' },
  { name: 'Requirements', detail: 'Business requirements, user stories and acceptance criteria a team can build and test from.' },
  { name: 'Process mapping', detail: 'Current and future processes drawn in BPMN, the notation most delivery teams read.' },
  { name: 'Stakeholders', detail: 'Knowing who a change affects, what each of them needs, and keeping them agreed.' },
  { name: 'Data basics', detail: 'Confident spreadsheets, and enough SQL to check facts for yourself.' },
  { name: 'Testing and delivery', detail: 'Planning UAT, and working in agile teams with backlogs and sprints.' },
];

const steps = [
  { name: 'Learn the foundations', detail: 'The role, the vocabulary, the documents' },
  { name: 'Practise on one case', detail: 'A real problem, from brief to sign-off' },
  { name: 'Build a portfolio', detail: 'Requirements, BPMN maps, stories, a test plan' },
  { name: 'Rewrite your CV', detail: 'Around the analysis you have done' },
  { name: 'Practise interviews', detail: 'Explain your work out loud' },
];

const faqs = [
  {
    q: 'Can I become a business analyst without a technical background?',
    a: 'Yes. The role is about understanding how work happens and writing it down clearly. People move into it from operations, customer service, finance, sales and teaching, among other jobs. Technical knowledge helps later, and you can build it as you go.',
  },
  {
    q: 'Do I need to learn to code?',
    a: "No. You need to understand systems well enough to describe what they should do. Some SQL is useful for checking data yourself, but writing code is the developers' job.",
  },
  {
    q: 'How long does it take to become a business analyst?',
    a: `It depends on where you start. A structured programme such as the ${cohort.programme} takes twelve weeks; after that, how long it takes to land a role depends on your experience, your portfolio and the jobs you apply for. We don't promise jobs or timelines.`,
  },
  {
    q: 'Is business analysis the same as data analysis?',
    a: 'No, though they overlap. A data analyst works mainly with data to answer questions. A business analyst works mainly with people and processes to define what a change should do, and uses data as one source of evidence.',
  },
  {
    q: 'Where can I learn business analysis in Nigeria?',
    a: `From books such as the IIBA's BABOK Guide, self-paced online courses, or a live programme with feedback on your work. The ${cohort.programme} is Practeva's live online programme, built around one case and the documents analysts write.`,
  },
];

const article = {
  '@type': 'Article',
  '@id': `${pageUrl(path)}#article`,
  headline: 'How to become a business analyst in Nigeria',
  description,
  url: pageUrl(path),
  mainEntityOfPage: { '@id': `${pageUrl(path)}#webpage` },
  image: pageUrl(site.ogImage),
  inLanguage: 'en-GB',
  datePublished: '2026-10-14',
  dateModified: '2026-10-14',
  author: { '@id': orgId },
  publisher: { '@id': orgId },
  about: ['Business analysis', 'Careers in Nigeria', 'Career change'],
};
---
<Page tone="paper" title={title} description={description} schema={[article]}>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Training', href: '/training' }, { label: 'Becoming a business analyst' }]}
    eyebrow="A guide for career changers"
    sub="What the job involves, what to learn first, and how to show employers you can do the work, even if you are starting from a different career."
  >
    <Fragment slot="title">How to become a business analyst in <em class="accent">Nigeria</em>.</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="/training#waitlist">Join the waitlist<Arrow /></a>
      <a class="link" href="#path">Skip to the path</a>
    </Fragment>
  </PageHero>

  <section class="ground-paper section" aria-labelledby="role-title">
    <div class="container">
      <SectionHead id="role-title" label="The role" title="What a business analyst does." />
      <div class="prose">
        <p>A business analyst works out what an organisation needs before anyone builds or buys anything, then writes it down so it can be built, tested and agreed. The role sits between the people who run the business and the people who change it: product teams, developers, vendors and project managers.</p>
        <p>Day to day, that means:</p>
        <ul>
          {duties.map((d) => <li>{d}</li>)}
        </ul>
      </div>

      <div class="block">
        <SectionHead id="where-title" label="In Nigeria" title="Where business analysts work." />
        <div class="prose">
          <p>Wherever an organisation is changing how it works with technology. In Nigeria that includes commercial and microfinance banks, fintechs and payment companies, insurers, government agencies, consulting firms, and companies building apps and platforms.</p>
          <p>Job titles vary. Business analyst, IT business analyst, systems analyst, process analyst and product analyst often describe overlapping work, so read the duties in a job advert, not only the title.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="skills ground-wash section" aria-labelledby="skills-title">
    <div class="container">
      <SectionHead
        id="skills-title"
        label="Skills"
        title="What to learn first."
        note="The tools matter less than the thinking. You will meet Jira and Confluence, a diagramming tool such as draw.io, Visio or Lucidchart, and plenty of Excel."
      />
      <NumberedGrid items={skills} cols={3} />
    </div>
  </section>

  <section class="ground-paper section" id="path" aria-labelledby="path-title">
    <div class="container">
      <SectionHead
        id="path-title"
        label="The path"
        title="A path for career changers."
        note="Five steps, in this order. Each one leaves you with something to show."
      />
      <ProcessFlow steps={steps} label="Becoming a business analyst, step by step" />

      <div class="notes">
        <div>
          <h3 class="subheading">Use the experience you already have</h3>
          <p>Many people do parts of the job before they have the title. If you have improved a process in operations, spotted a pattern in customer complaints, or tested a new system before it went live, that is analysis. Name it that way on your CV and in interviews.</p>
        </div>
        <div>
          <h3 class="subheading">Do you need a certification?</h3>
          <p>Not to start. What helps most early on is evidence that you can do the work, which a certificate cannot show on its own. Later, certification can help: the IIBA's ECBA is aimed at people starting out, and its CCBA and CBAP are for analysts with experience.</p>
        </div>
        <div>
          <h3 class="subheading">Where the {cohort.programme} fits</h3>
          <p>It follows this path in twelve weeks, live online on West Africa Time, in a cohort of {cohort.size}. You work one case for Lantern MFB, a fictional microfinance bank, and leave with a requirements document, BPMN maps, a user story backlog and a UAT plan, plus a CV rewrite and a mock interview.</p>
          <p class="more">
            <a class="link" href="/training#how">How a cohort works</a>
            <a class="link" href="/careers">Careers support</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Questions career changers ask" />
  <CohortBanner />
</Page>

<style>
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 40em;
    font-size: 18px;
    line-height: 28px;
  }

  .prose ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .prose li {
    position: relative;
    padding-left: 26px;
  }

  /* The leaf, as a list bullet */
  .prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 10px;
    height: 10px;
    border-radius: 5px 0 5px 0;
    background: var(--leaf-green);
  }

  .block {
    margin-top: clamp(56px, 8vw, 104px);
  }

  .skills {
    --wash-x: 100%;
    --wash-y: 30%;
    --wash2-x: 0%;
    --wash2-y: 80%;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8) clamp(32px, 4vw, 56px);
    margin-top: clamp(56px, 7vw, 88px);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }

  .notes > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .notes p {
    color: var(--ink-muted);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-2);
  }

  @media (max-width: 960px) {
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .prose {
      font-size: 17px;
      line-height: 26px;
    }
  }
</style>
