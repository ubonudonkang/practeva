---
import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import HeroFacts from '../components/HeroFacts.astro';
import HowItWorks from '../components/HowItWorks.astro';
import MarketDay from '../components/MarketDay.astro';
import TeamTraining from '../components/TeamTraining.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import SectionHead from '../components/SectionHead.astro';
import LocalTimes from '../components/LocalTimes.astro';
import { cohort, markets } from '../data/site';
import { orgId, pageUrl } from '../data/schema';

const faqs = [
  {
    q: 'When does the next cohort start?',
    a: `The ${cohort.next} cohort starts at ${cohort.nextStart}. It opens to the waitlist first.`,
  },
  {
    // TODO(ubon): confirm this answer reflects your entry requirements.
    q: 'Do I need a technical background?',
    a: 'No. The cohort is built for career changers and starts from the foundations of the role.',
  },
  {
    q: 'Can I join from outside Nigeria?',
    a: 'Yes, from anywhere in Nigeria or abroad. Live sessions run 8 to 10pm West Africa Time: 7 to 9pm in London and Dublin in winter, 11pm in Dubai, 2 to 4pm in New York and Toronto, and early morning in Sydney and Auckland. The table of session times shows your city. Both sessions are recorded.',
  },
  {
    q: 'How much time does it take each week?',
    a: `Two live sessions a week (${cohort.schedule}), both recorded, plus time on your weekly deliverable and a pod session your group arranges.`,
  },
  {
    q: 'How much does it cost?',
    a: cohort.fee
      ? `The fee is ${cohort.fee}${cohort.feeUsd ? `, or ${cohort.feeUsd} if you join from outside Nigeria` : ''}, paid in full when you enrol. We don't offer instalments at the moment.`
      : `The ${cohort.next} fee goes to the waitlist first, before public enrolment, with a fee in ${markets.abroadCurrency} for people joining from outside Nigeria. The ${cohort.previous} cohort was ${cohort.previousFee}, paid in full when you enrolled. We don't offer instalments at the moment.`,
  },
  {
    q: 'Can I defer to a later cohort?',
    a: "No. We don't offer deferrals, so join the cohort you can commit to.",
  },
  {
    q: 'Will I get a job at the end?',
    a: "We don't promise jobs. You finish with real case work to show, a rewritten CV and a mock interview behind you.",
  },
  {
    q: 'Can you train my team instead?',
    a: 'Yes. Team training is run separately from the cohort, for organisations. Tell us about your team through the contact form.',
  },
];

// The cohort as a Course for search results and AI assistants: only what the page says.
// No price until the February fee is set (cohort.fee).
const course = {
  '@type': 'Course',
  '@id': `${pageUrl('/training/')}#course`,
  name: cohort.programme,
  description: `Twelve weeks of live online, case-based business analysis training for career changers in Nigeria and abroad. You work one case for a fictional microfinance bank and leave with a requirements document, BPMN process maps, a user story backlog and a UAT plan, plus a CV rewrite and a mock interview.`,
  provider: { '@id': orgId },
  url: pageUrl('/training/'),
  inLanguage: 'en',
  educationalLevel: 'Beginner',
  teaches: [
    'Requirements elicitation and business requirements documents',
    'BPMN process mapping',
    'User stories and acceptance criteria',
    'User acceptance testing and traceability',
    'Stakeholder engagement',
    'Presenting a recommendation',
  ],
  hasCourseInstance: {
    '@type': 'CourseInstance',
    name: `${cohort.programme}, ${cohort.next}`,
    courseMode: 'Online',
    location: { '@type': 'VirtualLocation', url: pageUrl('/training/') },
    courseSchedule: {
      '@type': 'Schedule',
      repeatFrequency: 'P1W',
      byDay: ['https://schema.org/Wednesday', 'https://schema.org/Saturday'],
      startTime: '20:00',
      endTime: '22:00',
      scheduleTimezone: 'Africa/Lagos',
      duration: 'PT2H',
      repeatCount: 24,
    },
  },
  ...(cohort.fee && {
    offers: { '@type': 'Offer', category: 'Paid', priceCurrency: 'NGN', price: cohort.fee.replace(/[^\d.]/g, '') },
  }),
};
---
<Page
  tone="night"
  title="Business analysis training in Nigeria | BA Bridge Cohort"
  description={`Twelve weeks of live online, case-based business analysis training for career changers in Nigeria, the UK, Australia and more. Join the ${cohort.next} waitlist.`}
  schema={[course]}
  cta={{ label: 'Join the waitlist', href: '#waitlist' }}
>
  <PageHero
    tone="night"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Training' }]}
    eyebrow={`${cohort.programme}, ${cohort.next}`}
    sub="Live online cohorts, real case work and career support for people in Nigeria and abroad moving into IT business analysis."
  >
    <Fragment slot="title">Learn business analysis by <em class="accent">doing</em> the&nbsp;work.</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="#waitlist">Join the waitlist<Arrow /></a>
      <a class="link" href="#how">See how a cohort works</a>
    </Fragment>
    <HeroFacts
      items={[
        { term: 'Format', detail: cohort.format },
        { term: 'Cohort size', detail: cohort.size },
        { term: 'Next cohort', detail: `${cohort.next}, waitlist open` },
        { term: `${cohort.previous} cohort`, detail: cohort.previousStatus },
      ]}
    />
  </PageHero>

  <HowItWorks />
  <MarketDay />

  <section class="ground-paper section" id="times" aria-labelledby="times-title">
    <div class="container">
      <SectionHead
        id="times-title"
        label="Joining from abroad"
        title="Live sessions, in your time."
        note={`Classes run ${cohort.schedule.replace('Wednesdays and Saturdays, ', '')} on Wednesdays and Saturdays, and both are recorded. People joining from outside Nigeria pay in ${markets.abroadCurrency}.`}
      />
      <LocalTimes from={20} to={22} />
    </div>
  </section>

  <TeamTraining />
  <Faq items={faqs} />
  <Waitlist />
</Page>
