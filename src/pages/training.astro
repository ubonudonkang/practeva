---
import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import HeroFacts from '../components/HeroFacts.astro';
import HowItWorks from '../components/HowItWorks.astro';
import MarketDay from '../components/MarketDay.astro';
import Curriculum from '../components/Curriculum.astro';
import CohortCard from '../components/CohortCard.astro';
import NumberedGrid from '../components/NumberedGrid.astro';
import TeamTraining from '../components/TeamTraining.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Enrol from '../components/Enrol.astro';
import JoinCta from '../components/JoinCta.astro';
import SectionHead from '../components/SectionHead.astro';
import LocalTimes from '../components/LocalTimes.astro';
import { cohort, enrolment, join, site } from '../data/site';
import { cohortAudiences } from '../data/offers';
import { orgId, pageUrl } from '../data/schema';

// When the cohort starts, as a phrase: the exact date once it is fixed (site.ts), else the rough one
const starts = cohort.startDate ? `on ${cohort.startDate}` : `at ${cohort.nextStart}`;

const faqs = [
  {
    q: 'When does the next cohort start?',
    a: `The ${cohort.next} cohort starts ${starts}. ${
      enrolment.open
        ? `Enrolment is open${cohort.applyBy ? `, and applications close on ${cohort.applyBy} or earlier if places fill` : ''}.`
        : 'It opens to the waitlist first.'
    }`,
  },
  {
    // TODO(ubon): confirm this answer reflects your entry requirements.
    q: 'Do I need a technical background?',
    a: 'No. Most people come from research, banking, operations or customer-facing roles, and week 1 starts from the foundations of the role.',
  },
  {
    q: 'Can I join from outside Nigeria?',
    a: 'Yes, from anywhere in Nigeria or abroad. Live sessions run 8 to 10pm West Africa Time: 7 to 9pm in London and Dublin in winter, 11pm in Dubai, 2 to 4pm in New York and Toronto, and early morning in Sydney and Auckland. The table of session times shows your city. Both sessions are recorded.',
  },
  {
    q: 'How much time does it take each week?',
    a: `Two live sessions a week (${cohort.schedule}), both recorded, plus time on your weekly deliverable and a pod session your group arranges.`,
  },
  {
    q: 'How much does it cost?',
    a: cohort.fee
      ? `The fee is ${cohort.fee}, paid in full when you enrol, by card, bank transfer or USSD through Squad. We don't offer instalments at the moment. ${cohort.abroadFee}`
      : `The ${cohort.next} fee goes to the waitlist first, before public enrolment. The ${cohort.previous} cohort was ${cohort.previousFee}, paid in full when you enrolled. We don't offer instalments at the moment. ${cohort.abroadFee}`,
  },
  {
    q: 'When is my place confirmed?',
    a: enrolment.open
      ? "Submit the enrolment form first; Squad's secure checkout then opens. Squad confirms your payment to us directly, and we check it against your enrolment and email your joining details."
      : 'Joining the waitlist does not reserve a place. When enrolment opens, we will explain how to enrol and confirm a place.',
  },
  {
    q: 'What if I miss a live session?',
    a: "Every session is recorded, so you can catch up and still submit that week's assignment.",
  },
  {
    // TODO(ubon): confirm Practeva issues a certificate of completion (the personal site's page says so).
    q: 'Will this get me certified?',
    a: 'The cohort covers the BABOK foundations and ends with an ECBA roadmap. When you finish, you receive a BA Bridge Cohort certificate of completion. Professional certification exams, such as the ECBA, are taken separately through IIBA.',
  },
  {
    q: 'Will I get a job at the end?',
    a: "We don't promise jobs. You finish with real case work to show, a rewritten CV and a mock interview behind you.",
  },
  {
    // TODO(ubon): the personal site's refund policy says a place can move once to the next cohort at
    // no cost before the cohort begins; this answer and the refund policy below follow it. Confirm.
    q: 'Can I defer to a later cohort?',
    a: 'Not once training has begun. Before the cohort starts, you can move your place once to the next cohort at no cost.',
  },
  {
    q: 'What is the refund policy?',
    a: `If you withdraw before the cohort begins, you can request a refund less a 10% administrative fee, or move your place once to the next cohort at no cost. Once training has begun, fees are non-refundable and non-transferable. If Practeva postpones or cancels the cohort, you can choose a full refund with no deduction or a place in the next cohort. Send refund requests in writing to ${site.email}; we process them within 14 working days.`,
  },
  {
    q: 'Can you train my team instead?',
    a: 'Yes. Team training is run separately from the cohort, for organisations. Tell us about your team through the contact form.',
  },
];

// The cohort as a Course for search results and AI assistants: only what the page says.
// No price until the February fee is set (cohort.fee).
const course = {
  '@type': 'Course',
  '@id': `${pageUrl('/training/')}#course`,
  name: cohort.programme,
  description: `Twelve weeks of live online, case-based business analysis training for career changers in Nigeria and abroad. You work one case for a fictional microfinance bank and leave with a stakeholder map, a requirements document, BPMN process maps, a user story backlog and a UAT plan, plus a CV and LinkedIn rewrite and a mock interview.`,
  provider: { '@id': orgId },
  url: pageUrl('/training/'),
  inLanguage: 'en',
  educationalLevel: 'Beginner',
  teaches: [
    'Agile and Scrum ways of working',
    'Requirements elicitation and business requirements documents',
    'BPMN process mapping and data modelling',
    'User stories and acceptance criteria',
    'User acceptance testing and traceability',
    'Stakeholder mapping and engagement',
    'Presenting a recommendation',
  ],
  hasCourseInstance: {
    '@type': 'CourseInstance',
    name: `${cohort.programme}, ${cohort.next}`,
    courseMode: 'Online',
    location: { '@type': 'VirtualLocation', url: pageUrl('/training/') },
    courseSchedule: {
      '@type': 'Schedule',
      repeatFrequency: 'P1W',
      byDay: ['https://schema.org/Wednesday', 'https://schema.org/Saturday'],
      startTime: '20:00',
      endTime: '22:00',
      scheduleTimezone: 'Africa/Lagos',
      duration: 'PT2H',
      repeatCount: 24,
    },
  },
  ...(cohort.fee && {
    offers: { '@type': 'Offer', category: 'Paid', priceCurrency: 'NGN', price: cohort.fee.replace(/[^\d.]/g, '') },
  }),
};
---
<Page
  tone="night"
  title="Business analysis training in Nigeria | BA Bridge Cohort"
  description={`Twelve weeks of live online, case-based business analysis training for career changers in Nigeria, the UK, Australia and more. ${enrolment.open ? `Enrol in the ${cohort.next} cohort.` : `Join the ${cohort.next} waitlist.`}`}
  schema={[course]}
  cta={{ label: join.label, href: join.href.replace('/training', '') }}
>
  <PageHero
    tone="night"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Training' }]}
    eyebrow={`${cohort.programme}, ${cohort.next}`}
    sub="Live online cohorts, real case work and career support for people in Nigeria and abroad moving into IT business analysis."
  >
    <Fragment slot="title">Learn business analysis by <em class="accent">doing</em> the&nbsp;work.</Fragment>
    <Fragment slot="actions">
      <a class="btn" href={join.href.replace('/training', '')}>{join.label}<Arrow /></a>
      <a class="link" href="#how">See how a cohort works</a>
    </Fragment>
    <HeroFacts
      items={[
        { term: 'Format', detail: cohort.format },
        { term: 'Cohort size', detail: cohort.size },
        { term: 'Next cohort', detail: `${cohort.next}, ${enrolment.open ? 'enrolment open' : 'waitlist open'}` },
        { term: `${cohort.previous} cohort`, detail: cohort.previousStatus },
      ]}
    />
  </PageHero>

  <section class="ground-paper section" id="who" aria-labelledby="who-title">
    <div class="container">
      <SectionHead
        id="who-title"
        label="Who it's for"
        title="You already have more BA skills than you think."
        note="Most strong business analysts didn't start as business analysts. The cohort is built for people bringing experience from somewhere else."
      />
      <NumberedGrid items={cohortAudiences} cols={4} />
      <JoinCta spaced />
    </div>
  </section>

  <HowItWorks joined />
  <MarketDay />
  <Curriculum />
  <CohortCard />

  <section class="ground-paper section" id="times" aria-labelledby="times-title">
    <div class="container">
      <SectionHead
        id="times-title"
        label="Joining from abroad"
        title="Live sessions, in your time."
        note={`Classes run ${cohort.schedule.replace('Wednesdays and Saturdays, ', '')} on Wednesdays and Saturdays, and both are recorded. ${cohort.abroadFee}`}
      />
      <LocalTimes from={20} to={22} />
      <JoinCta spaced />
    </div>
  </section>

  <TeamTraining />
  <Faq items={faqs} />
  {enrolment.open ? <Enrol /> : <Waitlist />}
</Page>
