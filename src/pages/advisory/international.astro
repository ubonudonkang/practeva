---
// Advisory for teams outside Nigeria: the same services, delivered remotely from Lagos and
// quoted in US dollars. LocalTimes shows our 9am to 5pm (West Africa Time, UTC+1, no
// daylight saving) in each city in site.ts, in standard and summer time.
// First, so the page's stylesheets keep the order they had before the FAQ moved into src/content.
// First, so the page's stylesheets keep the order they had before its words moved into src/content.
import copyContent from '../../content/pages/international.json';
import { pageCopy } from '../../data/pages';

import { internationalFaqs } from '../../data/faqs';
import Page from '../../layouts/Page.astro';
import Arrow from '../../components/Arrow.astro';
import PageHero from '../../components/PageHero.astro';
import HeroFacts from '../../components/HeroFacts.astro';
import SectionHead from '../../components/SectionHead.astro';
import NumberedGrid from '../../components/NumberedGrid.astro';
import ProcessFlow from '../../components/ProcessFlow.astro';
import Faq from '../../components/Faq.astro';
import LocalTimes from '../../components/LocalTimes.astro';
import ContactBand from '../../components/ContactBand.astro';
import { engagement, services } from '../../data/offers';
import { markets } from '../../data/site';
import { areaServed, orgId, pageUrl } from '../../data/schema';

// The page's words are in src/content/pages/international.json (edited in Pages CMS)
const copy = pageCopy('international', copyContent, ['hours', 'services', 'remote']);

const path = '/advisory/international/';

const faqs = internationalFaqs; // src/content/faqs/international.json

const service = {
  '@type': 'Service',
  '@id': `${pageUrl(path)}#service`,
  name: 'Remote business analysis for international teams',
  serviceType: 'Business analysis and technology advisory',
  description:
    'Requirements, process mapping and improvement, process automation, business systems and digital transformation support, delivered remotely from Lagos, Nigeria, and quoted in US dollars.',
  provider: { '@id': orgId },
  areaServed: areaServed.slice(1),
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: pageUrl('/contact/') },
  url: pageUrl(path),
};
---
<Page
  tone="paper"
  title={copy.seoTitle}
  description={copy.description}
  schema={[service]}
>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Advisory', href: '/advisory' }, { label: 'International clients' }]}
    eyebrow={copy.hero.eyebrow}
    sub={copy.hero.sub}
  >
    <Fragment slot="title">{copy.hero.title.before}<em class="accent">{copy.hero.title.accent}</em>{copy.hero.title.after}</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="/contact?topic=advisory">Book a call<Arrow /></a>
      <a class="link" href="#hours">See our hours in your time</a>
    </Fragment>
    <HeroFacts
      items={[
        { term: 'Time zone', detail: `${markets.timezone}, all year` },
        { term: 'Pricing', detail: `Quoted in ${markets.abroadCurrency}` },
        { term: 'Working language', detail: 'English' },
      ]}
    />
  </PageHero>

  <section class="ground-paper section" id="hours" aria-labelledby="hours-title">
    <div class="container">
      <SectionHead id="hours-title" {...copy.section('hours')} />
      <LocalTimes from={9} to={17} share />
    </div>
  </section>

  <section class="services ground-wash section" aria-labelledby="services-title">
    <div class="container">
      <SectionHead id="services-title" {...copy.section('services')}>
        <a slot="aside" class="link" href="/advisory#packages">See the packages</a>
      </SectionHead>
      <NumberedGrid items={services} cols={3} />
    </div>
  </section>

  <section class="ground-paper section" aria-labelledby="remote-title">
    <div class="container">
      <SectionHead id="remote-title" {...copy.section('remote')} />
      <ProcessFlow steps={engagement} label="A remote engagement, step by step" />

      <div class="notes">
        <div>
          <h3 class="subheading">Calls and workshops</h3>
          <p>Video calls and online workshops on Teams, Zoom or Google Meet, whichever you use, planned inside the hours we share.</p>
        </div>
        <div>
          <h3 class="subheading">Your tools, your documents</h3>
          <p>We work in your tools where we can, such as Jira, Confluence, Miro or Microsoft 365, and everything we write is yours to keep.</p>
        </div>
        <div>
          <h3 class="subheading">Contracts and payment</h3>
          <p>Quoted and invoiced in {markets.abroadCurrency}. We can work under your NDA and data-handling terms; our <a class="link" href="/privacy">privacy notice</a> says how we treat personal data.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Questions from teams abroad" />

  <ContactBand
    title={copy.band.title}
    note={copy.band.note}
    cta={{ label: copy.band.label, href: '/contact?topic=advisory' }}
  />
</Page>

<style>
  .services {
    --wash-x: 0%;
    --wash-y: 30%;
    --wash2-x: 100%;
    --wash2-y: 80%;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8) clamp(32px, 4vw, 56px);
    margin-top: clamp(56px, 7vw, 88px);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }

  .notes > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .notes p {
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
