---
import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedGrid from '../components/NumberedGrid.astro';
import ContactBand from '../components/ContactBand.astro';
import { pillars, principles } from '../data/offers';
import { company, site } from '../data/site';
---
<Page
  tone="paper"
  title="About Practeva | Business analysis firm in Lagos State, Nigeria"
  description="Practeva Limited (RC 9931539) is a business analysis and technology advisory firm in Lagos State, Nigeria, registered on 12 October 2026."
  pageType="AboutPage"
>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    sub={`${company.legalName} was registered in Nigeria in October 2026 to do three things well: advise organisations on their processes, systems and automation, train the analysts who do that work, and help them show it to employers.`}
  >
    <Fragment slot="title">A business and technology firm that thinks like an <em class="accent">analyst</em>.</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="/contact">Book a call<Arrow /></a>
      <a class="link" href="#how-we-work">How we work</a>
    </Fragment>
  </PageHero>

  <section class="ground-paper section" aria-labelledby="pillars-title">
    <div class="container">
      <SectionHead id="pillars-title" label="What we do" title="Three practices, one craft." />
      <ul class="pillar-row">
        {pillars.map((p) => (
          <li class={`pr-${p.key}`}>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
            <a class="link" href={p.href}>See {p.name.toLowerCase()}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sign" aria-label="The Practeva sign">
    <img src="/images/practeva-wall-sign.webp" alt="The Practeva logo as a sign on a softly lit wall" width="1600" height="900" loading="lazy" />
  </section>

  <section class="ground-wash section principles" id="how-we-work" aria-labelledby="principles-title">
    <div class="container">
      <SectionHead
        id="principles-title"
        label="How we work"
        title="Four things we hold to."
        note="They shape how we write, how we teach and what we will and won't say we can do."
      />
      <NumberedGrid items={principles} cols={4} />
    </div>
  </section>

  <section class="ground-paper section" aria-labelledby="facts-title">
    <div class="container facts-grid">
      <SectionHead id="facts-title" label="Company details" title="The formal bits." />
      <dl class="facts">
        <div><dt>Registered name</dt><dd>{company.legalName}</dd></div>
        <div><dt>RC number</dt><dd>{company.rc}</dd></div>
        <div><dt>Registered</dt><dd>{company.registered}</dd></div>
        <div><dt>Company type</dt><dd>{company.type}</dd></div>
        <div><dt>Location</dt><dd>{company.location}</dd></div>
        <div><dt>Email</dt><dd><a class="link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
    </div>
  </section>

  <ContactBand
    title="Work with us, or learn with us."
    note="Whether you're planning a build, training a team or changing careers, start with a conversation."
    cta={{ label: 'Book a call', href: '/contact' }}
  />
</Page>

<style>
  /* Pillar row from the brand guide: name and one line under a rule in the pillar's colour */
  .pillar-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .pillar-row li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 4px solid var(--rule);
  }

  .pr-advisory {
    --rule: var(--deep-green);
  }

  .pr-training {
    --rule: var(--leaf-green);
  }

  .pr-careers {
    --rule: var(--forest-green);
  }

  .pillar-row h3 {
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.1;
    font-weight: var(--weight-headline);
    letter-spacing: -0.03em;
    color: var(--heading);
  }

  .pillar-row p {
    max-width: 22em;
    color: var(--ink-muted);
  }

  .pillar-row .link {
    margin-top: var(--space-2);
  }

  .sign {
    background: var(--paper);
  }

  .sign img {
    width: 100%;
    height: clamp(280px, 42vw, 620px);
    object-fit: cover;
    object-position: 20% 50%;
  }

  .principles {
    --wash-x: 0%;
    --wash-y: 60%;
    --wash2-x: 100%;
    --wash2-y: 40%;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8) clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .facts {
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-size: 13px;
    line-height: 24px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .facts dd {
    font-size: 17px;
    line-height: 24px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 960px) {
    .facts-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .pillar-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
