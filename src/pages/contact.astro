---
import Page from '../layouts/Page.astro';
import ContactForm from '../components/ContactForm.astro';
import { founder, site } from '../data/site';
---
<Page
  tone="paper"
  title="Contact Practeva | Book a call"
  description="Tell us what you're working on: advisory, team training, the BA Bridge Cohort or careers support."
>
  <section class="contact ground-wash" aria-labelledby="page-title">
    <div class="container contact-grid">
      <div class="contact-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">Contact</span></li>
          </ol>
        </nav>
        <!-- The italic accent word is the brand's signature: once per page, and this is the one -->
        <h1 id="page-title" class="contact-title">Tell us what you're <em class="accent">working</em> on.</h1>
        <p class="contact-sub">An idea to test, a process to fix, a team to train or a career move. Send a few lines and we'll reply by email to set up a call.</p>

        <figure class="expert">
          <div class="expert-frame leaf-lg">
            <img src={founder.photo} alt={founder.photoAlt} width="862" height="1080" />
          </div>
          <figcaption>
            <b>{founder.name}</b>
            <span>{founder.role}</span>
          </figcaption>
        </figure>

        <p class="caption">Prefer email? <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>

      <ContactForm />
    </div>
  </section>
</Page>

<style>
  .contact {
    --wash-top: var(--paper-clear);
    --wash-x: 0%;
    --wash-y: 0%;
    --wash2-x: 100%;
    --wash2-y: 100%;
    padding-top: clamp(148px, 15vw, 196px);
    padding-bottom: var(--section-y);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-14) clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-2);
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs [aria-current] {
    color: var(--heading);
  }

  .contact-title {
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1;
    font-weight: var(--weight-headline);
    letter-spacing: -0.045em;
    color: var(--heading);
    text-wrap: balance;
  }

  .contact-sub {
    max-width: 28em;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* The expert tile: a portrait crop in a leaf, like the reference's angled photo frames.
     The caption sits under the photo, where it reads against the page. */
  .expert {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: min(100%, 320px);
    margin-top: var(--space-4);
  }

  .expert-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--line);
  }

  .expert-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .expert figcaption {
    display: flex;
    flex-direction: column;
  }

  .expert figcaption b {
    font-size: 17px;
    line-height: 22px;
    font-weight: 600;
    color: var(--heading);
  }

  .expert figcaption span {
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .expert {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .contact {
      padding-top: 120px;
    }
  }
</style>
