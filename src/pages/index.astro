---
// Home: the company first, with Advisory leading. Training and Careers each have a door
// here and their own page.
// First, so the page's stylesheets keep the order they had before its words moved into src/content.
import copyContent from '../content/pages/home.json';
import { pageCopy } from '../data/pages';

import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import PillarIndex from '../components/PillarIndex.astro';
import Statement from '../components/Statement.astro';
import SectionHead from '../components/SectionHead.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import OfferCards from '../components/OfferCards.astro';
import Pillars from '../components/Pillars.astro';
import CohortBanner from '../components/CohortBanner.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import { beforeAfter, packages } from '../data/offers';
import { homeFaqs } from '../data/faqs';

// The page's words are in src/content/pages/home.json (edited in Pages CMS)
const copy = pageCopy('home', copyContent, ['spotlight']);

// Questions about the company as a whole (src/content/faqs/home.json); the training page keeps the cohort's own FAQ.
const faqs = homeFaqs;
---
<Page
  tone="night"
  description={copy.description}
>
  <PageHero
    tone="night"
    size="full"
    eyebrow={copy.hero.eyebrow}
    sub={copy.hero.sub}
  >
    <Fragment slot="title">{copy.hero.title.before}<em class="accent">{copy.hero.title.accent}</em>{copy.hero.title.after}</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="/contact?topic=advisory">Book a call<Arrow /></a>
      <a class="link" href="/advisory#services">See what we take on</a>
    </Fragment>
    <PillarIndex />
  </PageHero>

  <Statement />

  <section class="spotlight ground-wash section" aria-labelledby="spotlight-title">
    <div class="container">
      <SectionHead id="spotlight-title" {...copy.section('spotlight')}>
        <a slot="aside" class="link" href="/advisory">How advisory works</a>
      </SectionHead>

      <BeforeAfter before={beforeAfter.before} after={beforeAfter.after} />

      <div class="spotlight-packages">
        <h3 class="subheading">Three ways to start</h3>
        <OfferCards items={packages} topic="advisory" variant="compact" href="/advisory#packages" />
      </div>
    </div>
  </section>

  <Pillars />

  <CohortBanner />

  <Faq items={faqs} joined={false} />

  <ContactBand
    title={copy.band.title}
    note={copy.band.note}
    cta={{ label: copy.band.label, href: '/contact' }}
  />
</Page>

<style>
  .spotlight {
    --wash-x: 0%;
    --wash-y: 40%;
    --wash2-x: 100%;
    --wash2-y: 60%;
  }

  .spotlight-packages {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: clamp(48px, 7vw, 88px);
  }
</style>
