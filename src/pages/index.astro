---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Pillars from '../components/Pillars.astro';
import HowItWorks from '../components/HowItWorks.astro';
import MarketDay from '../components/MarketDay.astro';
import Trainer from '../components/Trainer.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Statement />
    <Pillars />
    <HowItWorks />
    <MarketDay />
    <Trainer />
    <Faq />
    <Waitlist />
  </main>
  <Footer />
</Base>
