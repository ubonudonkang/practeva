---
// Home: the company first, with Advisory leading. Training and Careers each have a door
// here and their own page.
import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import PillarIndex from '../components/PillarIndex.astro';
import Statement from '../components/Statement.astro';
import SectionHead from '../components/SectionHead.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import OfferCards from '../components/OfferCards.astro';
import Pillars from '../components/Pillars.astro';
import CohortBanner from '../components/CohortBanner.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import { beforeAfter, packages } from '../data/offers';
import { cohort, enrolment, markets } from '../data/site';

// Questions about the company as a whole; the training page keeps the cohort's own FAQ.
const faqs = [
  {
    q: 'What does Practeva do?',
    a: 'Practeva is a business analysis and technology advisory firm in Lagos State, Nigeria, and it does three things. Advisory for organisations: business analysis, process improvement and automation, business systems and digital transformation. Training: the BA Bridge Cohort for career changers, and workshops for teams. Careers: CV, profile, interview and portfolio support for analysts.',
  },
  {
    q: 'Is it only business analysis?',
    a: 'No. Business analysis is where we start, because mapped processes and clear requirements make every later decision cheaper. From there we help you automate repetitive work, choose and roll out business systems, improve how operations run and plan a wider digital transformation.',
  },
  {
    q: 'Who do you work with?',
    a: 'Founders testing an idea, teams changing a process, organisations choosing a system and leaders planning a transformation. If you are not sure where you fit, a short call will tell us both.',
  },
  {
    q: 'Where is Practeva based?',
    a: 'In Lagos State, Nigeria. We serve organisations across Nigeria and work remotely with teams in the UK, Ireland, Europe, North America, the UAE, Australia and New Zealand. Lagos is on UTC+1 all year, so our working day lines up with the UK and Europe, covers the Dubai afternoon and the North American morning, and meets Australia and New Zealand in their evening. The BA Bridge Cohort is taught live online.',
  },
  {
    q: 'How does an advisory engagement start?',
    a: 'With an intro call about what you are working on. We then agree the package, timeline and price before any work starts. Discovery and analysis follow, and we finish by presenting our findings with clear next steps.',
  },
  {
    q: 'How much does it cost?',
    a: `Advisory and careers support are quoted after a short call, once we know what you need; clients outside Nigeria are quoted and invoiced in ${markets.abroadCurrency}. ${
      cohort.fee
        ? `The ${cohort.next} BA Bridge Cohort is ${cohort.fee}. ${cohort.abroadFee}`
        : `The ${cohort.next} BA Bridge Cohort fee goes to the waitlist first; the ${cohort.previous} cohort was ${cohort.previousFee}.`
    }`,
  },
  {
    q: 'Can you train our team?',
    a: 'Yes. Team training runs separately from the cohort and covers business analysis foundations, process improvement, agile delivery and digital skills, online, in person or blended.',
  },
  {
    q: 'I want to move into business analysis. Where do I start?',
    a: `With the ${cohort.programme}: ${cohort.format.toLowerCase()}, built for career changers. ${enrolment.open ? `Enrolment for the ${cohort.next} cohort is open.` : `The ${cohort.next} cohort opens to the waitlist first.`} If you are already applying for roles, careers support can help with your CV, profile and interviews.`,
  },
];
---
<Page
  tone="night"
  description="Business analysis and technology advisory from Lagos State, Nigeria, for teams at home and abroad. We improve processes, automate work and train analysts."
>
  <PageHero
    tone="night"
    size="full"
    eyebrow="Business and technology advisory"
    sub="We help organisations in Nigeria and abroad map and improve their processes, automate the repetitive work and choose systems that fit, starting with clear requirements."
  >
    <Fragment slot="title">Technology that fits the way your business&nbsp;<em class="accent">works</em>.</Fragment>
    <Fragment slot="actions">
      <a class="btn" href="/contact?topic=advisory">Book a call<Arrow /></a>
      <a class="link" href="/advisory#services">See what we take on</a>
    </Fragment>
    <PillarIndex />
  </PageHero>

  <Statement />

  <section class="spotlight ground-wash section" aria-labelledby="spotlight-title">
    <div class="container">
      <SectionHead
        id="spotlight-title"
        label="Advisory"
        title="Fix the process before you buy the system."
        note="Most of what goes wrong in a change was decided before it started: processes nobody mapped, requirements nobody wrote down, systems chosen before the need was clear."
      >
        <a slot="aside" class="link" href="/advisory">How advisory works</a>
      </SectionHead>

      <BeforeAfter before={beforeAfter.before} after={beforeAfter.after} />

      <div class="spotlight-packages">
        <h3 class="subheading">Three ways to start</h3>
        <OfferCards items={packages} topic="advisory" variant="compact" href="/advisory#packages" />
      </div>
    </div>
  </section>

  <Pillars />

  <CohortBanner />

  <Faq items={faqs} joined={false} />

  <ContactBand
    title="Tell us what you're working on."
    note="An idea to test, a process to fix, work to automate or a system to choose. A short call is enough to see where we can help."
    cta={{ label: 'Book a call', href: '/contact' }}
  />
</Page>

<style>
  .spotlight {
    --wash-x: 0%;
    --wash-y: 40%;
    --wash2-x: 100%;
    --wash2-y: 60%;
  }

  .spotlight-packages {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: clamp(48px, 7vw, 88px);
  }
</style>
