---
// Every page: the HTML shell, the header in the tone of the page's first section, and the footer.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Match the ground of the page's first section: 'night' or 'paper' (paper and wash heroes) */
  tone?: 'night' | 'paper';
  /** The header's call to action, when a page has a more specific one than booking a call */
  cta?: { label: string; href: string };
}

const { title, description, tone = 'night', cta } = Astro.props;
---
<Base title={title} description={description}>
  <Header tone={tone} cta={cta} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>
